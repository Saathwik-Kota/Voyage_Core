### ====================================================================
### VoyageCore Distributed Microservices Platform - API Collection
### ====================================================================

@baseUrl = http://localhost:3000

### 1. API Gateway Health & Downstream Service Discovery
GET {{baseUrl}}/health
Content-Type: application/json

### 2. Public Travel Catalog (Booking Engine)
GET {{baseUrl}}/api/travels
Content-Type: application/json

### 3. Public Destination Catalog (Booking Engine)
GET {{baseUrl}}/api/destinations
Content-Type: application/json

### 4. Admin Authentication (Identity Manager)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@travel.com",
  "password": "Admin@123"
}

### Store Auth Token from Login
@authToken = {{login.response.body.token}}

### 5. Verify Token Authenticity
POST {{baseUrl}}/api/auth/verify
Authorization: Bearer {{authToken}}
Content-Type: application/json

### 6. Register a New User
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "candidate@iiitb.ac.in",
  "password": "SecurePassword@123",
  "firstName": "Saathwik",
  "lastName": "Kota",
  "phone": "+919876543210"
}

### 7. Get All User Profiles (Profile Service - Admin Only)
GET {{baseUrl}}/api/users
Authorization: Bearer {{authToken}}
Content-Type: application/json

### 8. Create a Travel Package (Booking Engine - Admin Only)
# @name createTravel
POST {{baseUrl}}/api/travels
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Swiss Alpine Express",
  "description": "7-day scenic railway and hiking tour through the Swiss Alps",
  "price": 3200.00,
  "durationDays": 7,
  "startDate": "2026-08-15",
  "endDate": "2026-08-22",
  "maxParticipants": 16,
  "status": "active"
}

### 9. Get Payment Gateways (Transaction Service - Admin Only)
GET {{baseUrl}}/api/payment-methods
Authorization: Bearer {{authToken}}
Content-Type: application/json

### 10. Process Stripe Payment Intent (Transaction Service)
POST {{baseUrl}}/api/payments/stripe
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "amount": 3200.00,
  "currency": "usd",
  "bookingId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "paymentMethodId": "b2c3d4e5-f6a7-8901-bcde-f12345678901"
}

